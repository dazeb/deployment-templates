# Database Configuration
DATABASE_URI=postgres://payload:REPLACE_WITH_PASSWORD@db:5432/payload
DB_PASSWORD=REPLACE_WITH_PASSWORD

# Payload CMS Configuration
PAYLOAD_SECRET=REPLACE_WITH_SECRET
PAYLOAD_PUBLIC_SERVER_URL=https://your-app.app.payloadservers.com
ADMIN_EMAIL=admin@example.com

# S3 Storage Configuration
S3_BUCKET=your-bucket-name
S3_REGION=auto
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_ENDPOINT=https://s3.provider.com
S3_PREFIX=tenant-name/
